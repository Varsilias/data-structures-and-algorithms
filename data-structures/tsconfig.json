{
  "compilerOptions": {
    "target": "ES2021",
    "module": "nodenext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "types": ["node"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "../.build/typescript",
    "rootDir": "."
  },
  "include": [
    "list/**/*.ts",
    "stack/**/*.ts",
    "queue/**/*.ts",
    "ring-buffer/**/*.ts",
    "dynamic-ring-buffer/**/*.ts",
    "linked-list/**/*.ts",
    "hash-map/**/*.ts",
    "tree/**/*.ts",
    "heap/**/*.ts",
    "graph/**/*.ts",
    "trie/**/*.ts"
  ]
}
